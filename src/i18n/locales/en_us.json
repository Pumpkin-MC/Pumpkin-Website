    "sourceTag": "From the source",
    "sourceBody": "<b>Where the statuses come from.</b> Entities, redstone, combat and world were checked by hand against the maintainers' tracking issues. Blocks, items and commands come from the source tree: if Pumpkin has a file for it, it counts as implemented, and a TODO inside that file knocks it down to partial. Nobody compared behaviour against vanilla line by line, so green means the code exists, not that every edge case matches. The whole list lives in one file. Fix <data>data.json</data> and open a pull request.",
    "categories": {
      "all": {
        "label": "All",
        "unit": "entries",
        "description": "Every tracked entry across all categories."
      },
      "entities": {
        "label": "Entities",
        "unit": "entities",
        "description": "All 160 entity types in the 26.3-26.51 registry, with source reviews where available. Registry presence alone does not establish behaviour parity."
      },
      "blocks": {
        "label": "Blocks",
        "unit": "block behaviours",
        "description": "Block behaviour files discovered in the server source, plus explicitly tracked gaps. File discovery is not a complete vanilla block audit."
      },
      "items": {
        "label": "Items",
        "unit": "item behaviours",
        "description": "Item behaviour files discovered in the server source, plus selected shared mechanics. File discovery is not a complete vanilla item audit."
      },
      "commands": {
        "label": "Commands",
        "unit": "commands",
        "description": "Curated Java command inventory and Pumpkin extras. A matching filename does not establish command or alias parity."
      },
      "redstone": {
        "label": "Redstone",
        "unit": "components",
        "description": "Inventory of redstone components and mechanics; assessments require a source review."
      },
      "combat": {
        "label": "Combat",
        "unit": "mechanics",
        "description": "Inventory of melee, ranged and damage mechanics; assessments require a source review."
      },
      "world": {
        "label": "World",
        "unit": "systems",
        "description": "Inventory of persistence, physics and world systems; assessments require a source review."
      }
